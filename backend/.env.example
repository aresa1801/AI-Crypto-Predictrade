# Backend Environment Variables Template
# Copy this file to .env and fill in your values

# ===========================================
# Application Settings
# ===========================================
APP_NAME=AI-Crypto-Predictrade
DEBUG=false
ENVIRONMENT=production
API_VERSION=v1

# Server
HOST=0.0.0.0
PORT=8000

# Security (CHANGE IN PRODUCTION!)
SECRET_KEY=your-super-secret-key-min-32-characters-long

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# ===========================================
# Database (PostgreSQL)
# ===========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=predictrade
DB_USER=postgres
DB_PASSWORD=your-database-password

# ===========================================
# Redis
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===========================================
# Exchange API Keys (CEX)
# ===========================================

# Binance
EXCHANGE_BINANCE_API_KEY=your-binance-api-key
EXCHANGE_BINANCE_API_SECRET=your-binance-api-secret
EXCHANGE_BINANCE_TESTNET=true

# Bybit
EXCHANGE_BYBIT_API_KEY=your-bybit-api-key
EXCHANGE_BYBIT_API_SECRET=your-bybit-api-secret
EXCHANGE_BYBIT_TESTNET=true

# ===========================================
# Polymarket
# ===========================================
POLYMARKET_API_KEY=your-polymarket-api-key
POLYMARKET_API_SECRET=your-polymarket-api-secret
POLYMARKET_PRIVATE_KEY=your-wallet-private-key
POLYMARKET_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/your-key

# ===========================================
# AI & LLM Settings
# ===========================================
AI_OPENROUTER_API_KEY=your-openrouter-api-key
AI_OPENAI_API_KEY=your-openai-api-key-fallback
AI_MODEL=openai/gpt-4-turbo-preview
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=4096

# ===========================================
# Risk Management
# ===========================================
RISK_MAX_POSITION_SIZE_PCT=2.0
RISK_MAX_PORTFOLIO_RISK_PCT=10.0
RISK_DAILY_LOSS_LIMIT_PCT=5.0
RISK_MAX_DRAWDOWN_PCT=15.0
RISK_MIN_RISK_REWARD_RATIO=1.5
RISK_VAR_CONFIDENCE_LEVEL=0.95
RISK_MAX_OPEN_POSITIONS=10
RISK_COOLDOWN_MINUTES=5
