# dependencies
node_modules/
frontend/node_modules/

# next.js
.next/
frontend/.next/
/out/
frontend/out/

# production
/build
frontend/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ===========================================
# Backend (Python)
# ===========================================

# Byte-compiled / optimized / DLL files
